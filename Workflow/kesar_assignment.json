        "inputSchema": "\n{\n  \"type\": \"object\",\n  \"required\": [\n    \"intent\",\n    \"secondary_intent\",\n    \"order_id\",\n    \"sentiment\",\n    \"language\",\n    \"confidence\",\n    \"summary\"\n  ],\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"order_status\",\n        \"product_query\",\n        \"return_refund\",\n        \"complaint\",\n        \"other\"\n      ]\n    },\n    \"secondary_intent\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\n        \"order_status\",\n        \"product_query\",\n        \"return_refund\",\n        \"complaint\",\n        \"other\",\n        null\n      ]\n    },\n    \"order_id\": {\n      \"type\": [\"string\", \"null\"],\n      \"pattern\": \"^KC-[0-9]{4}$\"\n    },\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"positive\",\n        \"neutral\",\n        \"negative\",\n        \"angry\"\n      ]\n    },\n    \"language\": {\n      \"type\": \"string\",\n      \"enum\": [\"en\", \"hi\", \"hinglish\"]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"maxLength\": 200\n    }\n  },\n  \"additionalProperties\": true\n}\n"
